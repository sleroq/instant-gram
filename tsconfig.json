{
    "extends": "./.wxt/tsconfig.json",
    "compilerOptions": {
        "allowJs": false,
        "checkJs": false,
        "strict": true,
        "jsx": "preserve",
        "jsxImportSource": "@solidjs/web",
        "baseUrl": ".",
        "ignoreDeprecations": "6.0",
        "allowImportingTsExtensions": true,
        "paths": { "teact/*": ["vendor/teact/src/teact/*"] }
    },
    "include": ["**/*", ".wxt/wxt.d.ts", "shim.d.ts"],
    "exclude": [".output", ".output-solid", "instant-gram"]
}
