#!/bin/sh
set -eu

port_file="${HELIUM_USER_DATA_DIR:-$HOME/Library/Application Support/net.imput.helium}/DevToolsActivePort"

if [ ! -r "$port_file" ]; then
  echo "Helium remote debugging is not enabled: $port_file is unavailable" >&2
  exit 1
fi

port=$(sed -n '1p' "$port_file")
path=$(sed -n '2p' "$port_file")

exec npx -y chrome-devtools-mcp@latest \
  "--ws-endpoint=ws://127.0.0.1:${port}${path}" \
  --no-usage-statistics \
  --no-performance-crux
