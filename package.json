        "wxt": "0.20.27"
    },
    "devDependencies": {
        "@solidjs/vite-plugin": "3.0.0-next.41",
        "@types/react": "^18.3.28",
        "fake-indexeddb": "6.2.5",
        "playwright": "1.54.2",
        "sass": "^1.93.2",
        "typescript": "6.0.3",
        "vite": "8.1.3"
    },
    "overrides": {
        "@solidjs/babel-plugin": "2.0.0-rc.7",
