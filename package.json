{
    "name": "instagram-client-reels",
    "version": "0.1.0",
    "type": "module",
    "packageManager": "bun@1.4.3",
    "engines": {
        "bun": ">=1.4.3"
    },
    "scripts": {
        "dev": "wxt",
        "format": "prettier --write .",
        "lint": "oxlint --deny-warnings entrypoints lib tests wxt.config.ts oxlint.config.ts",
        "build": "wxt build",
        "check": "tsc --noEmit",
        "zip": "wxt zip",
        "test:setup": "playwright install chromium",
        "test": "sh -c 'for file in tests/*.test.ts; do bun test --timeout 30000 \"$file\" || exit $?; done'",
        "prepare": "wxt prepare"
    },
    "dependencies": {
        "@solidjs/web": "2.0.0-rc.21",
        "effect": "4.1.2",
        "solid-js": "2.0.0-rc.21",
        "webextension-polyfill": "0.12.0",
        "wxt": "0.21.5"
    },
    "devDependencies": {
        "@solidjs/vite-plugin": "3.0.0-next.57",
        "@types/webextension-polyfill": "0.12.6",
        "eslint-plugin-solid": "0.19.0",
        "fake-indexeddb": "6.2.8",
        "oxlint": "1.92.0",
        "playwright": "1.65.0",
        "prettier": "3.9.10",
        "sass": "^1.108.1",
        "typescript": "7.0.2",
        "vite": "8.3.6"
    },
    "overrides": {
        "@solidjs/babel-plugin": "2.0.0-rc.7",
        "@solidjs/compiler": "2.0.0-rc.7"
    },
    "trustedDependencies": [
        "@parcel/watcher",
        "esbuild",
        "fsevents",
        "msgpackr-extract",
        "spawn-sync"
    ]
}
