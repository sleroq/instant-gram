{
    "name": "instagram-client-reels",
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "wxt",
        "format": "prettier --write .",
        "lint": "oxlint --deny-warnings entrypoints lib tests wxt.config.ts oxlint.config.ts",
        "build": "wxt build",
        "check": "tsc --noEmit",
        "zip": "wxt zip",
        "test:setup": "playwright install chromium",
        "test": "node --experimental-strip-types --test --test-concurrency=1 tests/*.test.ts",
        "prepare": "wxt prepare"
    },
    "dependencies": {
        "@solidjs/web": "2.0.0-rc.7",
        "effect": "4.0.0-beta.107",
        "solid-js": "2.0.0-rc.7",
        "webextension-polyfill": "0.12.0",
        "wxt": "0.20.27"
    },
    "devDependencies": {
        "@solidjs/vite-plugin": "3.0.0-next.41",
        "@types/webextension-polyfill": "0.12.3",
        "eslint-plugin-solid": "0.18.0",
        "fake-indexeddb": "6.2.5",
        "oxlint": "1.79.0",
        "playwright": "1.54.2",
        "prettier": "3.6.2",
        "sass": "^1.93.2",
        "typescript": "6.0.3",
        "vite": "8.1.3"
    },
    "overrides": {
        "@solidjs/babel-plugin": "2.0.0-rc.7",
        "@solidjs/compiler": "2.0.0-rc.7"
    },
    "allowScripts": {
        "@parcel/watcher@2.6.0": true,
        "esbuild@0.27.7": true,
        "fsevents@2.3.3": true,
        "fsevents@2.3.2": true,
        "msgpackr-extract@3.0.4": true,
        "spawn-sync@1.0.15": true
    }
}
