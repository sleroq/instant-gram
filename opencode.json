{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "servers": {
            "chrome-devtools": {
                "type": "local",
                "command": [
                    "npx",
                    "-y",
                    "chrome-devtools-mcp@latest",
                    "--browser-url=http://127.0.0.1:9223",
                    "--categoryExtensions",
                    "--no-usage-statistics",
                    "--no-performance-crux"
                ],
                "environment": {
                    "NPM_CONFIG_REGISTRY": "https://registry.npmjs.org"
                }
            }
        }
    }
}
